# REAflix API (Flask)
PORT=5001
MONGO_URI=mongodb://reaflix_admin:change-me@localhost:27018/?authSource=admin
MONGO_DB=reaflix
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=1440
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
MEDIA_BASE_URL=http://localhost:4000
MEDIA_SIGNING_SECRET=same-value-as-the-media-server
SIGNED_URL_TTL_SECONDS=3600
CACHE_TTL_SECONDS=60
RATE_LIMIT_DEFAULT=300 per minute
RATE_LIMIT_AUTH=10 per minute

# Admin account created by: python -m seed.admin
ADMIN_EMAIL=admin@reaflix.io
ADMIN_PASSWORD=change-me
