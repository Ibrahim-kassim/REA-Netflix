# REAflix media server
PORT=4000
# Comma-separated list of origins allowed to load media (the front end)
CORS_ORIGINS=http://localhost:5173
# Folder that holds videos/ and images/
STORAGE_DIR=./storage
# Shared with the API: videos need ?exp=&sig= signed by this secret
MEDIA_SIGNING_SECRET=change-me-to-a-long-random-string
REQUIRE_SIGNED_VIDEOS=true
RATE_LIMIT_PER_MINUTE=600
